{
  "name": "viajando-con-cabeza-web",
  "private": true,
  "version": "0.1.0",
  "description": "VCC static travel website and reusable editorial tooling",
  "type": "module",
  "scripts": {
    "seo:sync": "node configuracion/scripts/preparar-publicacion.mjs --write",
    "seo:check": "node configuracion/scripts/preparar-publicacion.mjs --check && node configuracion/scripts/verificar-seo-global.mjs",
    "test": "node configuracion/scripts/comprobar-rutas.mjs && node configuracion/scripts/verificar-seo-global.mjs && node configuracion/scripts/verificar-seo-como-llegar.mjs && node configuracion/scripts/verificar-presupuestos-vcc.mjs && node configuracion/scripts/verificar-contacto-vcc.mjs && node configuracion/scripts/verificar-css-vcc.mjs && node configuracion/scripts/auditar-escalabilidad-vcc.mjs --strict-hubs && node configuracion/scripts/sincronizar-catalogo-vcc.mjs --check && npm run site:check",
    "css:check": "node configuracion/scripts/verificar-css-vcc.mjs",
    "audit:site": "node configuracion/scripts/auditar-escalabilidad-vcc.mjs",
    "catalog:sync": "node configuracion/scripts/sincronizar-catalogo-vcc.mjs --write",
    "site:sync": "node configuracion/scripts/generate-planifica-hubs.mjs && node configuracion/scripts/sincronizar-catalogo-vcc.mjs --write && node configuracion/scripts/preparar-publicacion.mjs --write",
    "site:check": "node configuracion/scripts/generate-planifica-hubs.mjs --check && node configuracion/scripts/sincronizar-catalogo-vcc.mjs --check && node configuracion/scripts/preparar-publicacion.mjs --check && node configuracion/scripts/verificar-seo-global.mjs",
    "destino:crear": "node configuracion/scripts/destinos.mjs crear",
    "destino:generar": "node configuracion/scripts/destinos.mjs generar",
    "deploy:check-quality": "node configuracion/scripts/verificar-config-despliegue.mjs --quality",
    "deploy:check-production": "node configuracion/scripts/verificar-config-despliegue.mjs --main"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "sharp": "0.34.4"
  }
}
