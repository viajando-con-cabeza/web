# Exclude Git metadata from Cloudflare Workers static assets.
# Cover root and nested Git directories, including generated pack files.
.git
.git/
**/.git
**/.git/
**/.git/**
*.pack
*.idx
*.rev
*.bitmap

# Exclude repository and local development metadata.
.github
.github/
**/.github/**
node_modules
node_modules/
**/node_modules/**
.wrangler
.wrangler/
**/.wrangler/**

# Tooling and editable templates must not be served as public web assets.
configuracion/scripts/
configuracion/scripts/**
configuracion/plantillas/
configuracion/plantillas/**
configuracion/workers/
configuracion/workers/**
